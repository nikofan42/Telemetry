# Firebase Configuration
FIREBASE_CREDS_PATH=path/to/your/firebase-credentials.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Telemetry Collection Settings
DEFAULT_CAR_IDX=-1  # Set to car index to track by default
UPDATE_RATE=60      # Main telemetry update rate in Hz
WEATHER_UPDATE_RATE=10  # Weather update rate in Hz

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL 